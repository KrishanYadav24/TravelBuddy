# TravelBuddy Environment Configuration

# OpenWeatherMap API Key (Get from https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=mock_openweather_key

# Firebase Configuration Parameters
FIREBASE_PROJECT_ID=travelbuddy-india-demo
FIREBASE_API_KEY=mock_firebase_key
FIREBASE_APP_ID=1:1234567890:android:mockappid
FIREBASE_MESSAGING_SENDER_ID=1234567890

# Global Feature Flag: Enable Mock/Demo Mode (set to true to use offline mock data fallback)
USE_MOCK_DATA=true
